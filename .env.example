# =============================================================================
# nearcade — example environment for local development
#
# Recommended: run `pnpm dev:setup` instead of copying this file manually.
# It starts the Docker Compose stack (app + mongo + redis + meilisearch +
# minio) and generates a local `.env` with random SSC_SECRET / AUTH_SECRET
# and OSS_S3_BASE64 derived from the MinIO config.
#
# The app runs inside its own container and reaches the backing services over
# the internal Compose network only — hence values like `mongodb://mongo:27017`
# below (the service name), not `localhost`. Only the app's own dev server is
# published to the host, at http://localhost:5173. See docker-compose.yml if
# you need to expose a backing service directly (e.g. mongosh) for inspection.
#
# Build-time vars (PUBLIC_* and the private ones below) are baked into the
# bundle by Vite/SvelteKit. They MUST be present (an empty string is fine) or
# the build fails. Empty values are handled gracefully at runtime — the
# corresponding feature simply degrades. Fill in real keys only if you need
# that feature locally.
# =============================================================================

# === BUILD TIME (public) ===
# Map / analytics / Firebase client keys.
PUBLIC_AMAP_KEY = ""
PUBLIC_TENCENT_MAPS_KEY = ""
PUBLIC_GOOGLE_MAPS_MAP_ID = ""
PUBLIC_GOOGLE_MAPS_API_KEY = ""
PUBLIC_CLARITY_PROJECT_ID = ""

PUBLIC_FIREBASE_API_KEY = ""
PUBLIC_FIREBASE_PROJECT_ID = ""
PUBLIC_FIREBASE_AUTH_DOMAIN = ""
PUBLIC_FIREBASE_STORAGE_BUCKET = ""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID = ""
PUBLIC_FIREBASE_APP_ID = ""
PUBLIC_FIREBASE_MEASUREMENT_ID = ""
PUBLIC_FIREBASE_VAPID_KEY = ""

PUBLIC_BAIDU_SITE_VERIFICATION = ""

# === BUILD TIME (private) ===
# Server-side secret for the AMap proxy.
AMAP_SECRET = ""
# WeChat template IDs.
WECHAT_TEMPLATE_BIND_RESULT = ""
WECHAT_TEMPLATE_QUEUE_NOTIFICATION = ""
# Firebase/FCM proxy hosts.
FCM_PROXY_HOST = ""
GLOAUTH2_PROXY_HOST = ""
# Firebase Admin service-account key (base64).
GSAK_BASE64 = ""

# Server-to-server communication secret (generate a random string).
SSC_SECRET = "change-me"

ADAPTER = "node"

# === RUNTIME ===
# Auth secret (generate a random string).
AUTH_SECRET = "change-me"

ALLOWED_ORIGINS = "http://localhost:5173"

MONGODB_URI = "mongodb://mongo:27017/?dbName=nearcade"

REDIS_URI = "redis://redis:6379"

MEILISEARCH_HOST = "http://meilisearch:7700"
MEILISEARCH_API_KEY = "dev-master-key"

AMAP_KEY = ""

# GitHub OAuth is the only provider required for a usable local login.
# Create your own GitHub OAuth app and fill these in.
AUTH_GITHUB_ID = ""
AUTH_GITHUB_SECRET = ""
AUTH_GITHUB_PROXY = ""

# Optional OAuth providers — leave empty unless you need them locally.
AUTH_MICROSOFT_ENTRA_ID_ID = ""
AUTH_MICROSOFT_ENTRA_ID_SECRET = ""
AUTH_MICROSOFT_ENTRA_ID_ISSUER = ""
AUTH_DISCORD_ID = ""
AUTH_DISCORD_SECRET = ""
AUTH_OSU_ID = ""
AUTH_OSU_SECRET = ""
AUTH_PHIRA_ID = ""
AUTH_PHIRA_SECRET = ""
AUTH_QQ_ID = ""
AUTH_QQ_SECRET = ""
AUTH_QQ_PROXY = ""
AUTH_DIVING_FISH_ID = ""
AUTH_DIVING_FISH_SECRET = ""

# WeChat official account — optional.
WECHAT_APPID = ""
WECHAT_SECRET = ""
WECHAT_TOKEN = ""

# QQ verification via qbind — optional.
QBIND_KEY_PREFIX = "nearcade"
QBIND_GROUPS = "[]"

# UNIFIED_SMS_URL = "http://localhost:7272"
# UNIFIED_MAIL_URL = "http://localhost:7273"

# OSS — optional. Prefer S3.
# OSS_S3_BASE64 is a base64-encoded JSON blob consumed by src/lib/oss/s3.ts.
# `pnpm dev:setup` generates this automatically from the MinIO config:
#   {"endpoint":"http://minio:9000","region":"us-east-1","bucket":"nearcade",
#    "accessKeyId":"minioadmin","secretAccessKey":"minioadmin",
#    "bucketEndpoint":false,"forcePathStyle":true}
OSS_S3_BASE64 = ""
# LeanCloud fallback — leave empty when using S3.
OSS_LEANCLOUD_APP_ID = ""
OSS_LEANCLOUD_APP_KEY = ""
OSS_LEANCLOUD_SERVER_URL = ""
OSS_LEANCLOUD_MASTER_KEY = ""

# Optional reverse proxy.
# REVERSE_PROXY = "https://example.com/?url="

# Credentialed CORS — extra origins (besides loopback dev origins) allowed to
# make credentialed cross-origin API requests. Comma-separated exact origins.
# Must be present at BUILD time; in CI this comes from the
# CORS_ALLOWED_ORIGINS actions secret.
CORS_ALLOWED_ORIGINS = ""
